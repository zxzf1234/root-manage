# 开发环境
NODE_ENV=production

VITE_DEV=false

VITE_SERVER_IP='115.190.25.160'

VITE_SERVER_PORT='48080'

# 后端请求路径
VITE_BASE_PATH=/root-client/

# 是否删除debugger
VITE_DROP_DEBUGGER=false

# 是否删除console.log
VITE_DROP_CONSOLE=false

# 是否sourcemap
VITE_SOURCEMAP=true

# 输出路径
