/**
* ${interface.comment}
*/
#if(${interfaceInput} == "")${interfaceInput}
export const ${interfaceNameHump} = () => {
  return request.${interface.method}({ url: '/${modulePath}/${interface.name}'})
}
#else
    #if(${interfaceInputSingleParam}!="")
export const ${interfaceNameHump} = ($interfaceInputVar) => {
  return request.${interface.method}({ url: '/${modulePath}/${interface.name}?${interfaceInputVar}=' + ${interfaceInputVar}})
}
    #else
export const ${interfaceNameHump} = (params) => {
  return request.${interface.method}({ url: '/${modulePath}/${interface.name}', params })
}
    #end
#end